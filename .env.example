# Copy to .env to override defaults (docker compose reads .env automatically).
# Every value here has a default in docker-compose.yml, so .env is optional.

POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag

LOG_LEVEL=info

# --- LLM (any OpenAI-compatible endpoint) ---
# Local default: Ollama inside compose. On a Mac, Docker has no GPU access, so a 7B model is
# CPU-only (~30-60s/answer). For faster demos set LLM_MODEL=qwen2.5:3b.
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=ollama   # Ollama ignores this; a hosted provider needs a real key

# Hosted example (swap in, no code changes):
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-...
