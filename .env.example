# Copy to .env to override defaults (docker compose reads .env automatically).
# Every value here has a default in docker-compose.yml, so .env is optional.

POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag

LOG_LEVEL=info

# --- Embeddings ---
# ollama (default): nomic-embed-text pulled into the Ollama container, fully local.
EMBEDDINGS_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
# openai: hosted API (any OpenAI-compatible /embeddings endpoint):
#   EMBEDDINGS_PROVIDER=openai
#   EMBEDDING_MODEL=text-embedding-3-small
#   OPENAI_API_KEY=sk-...
# Switching provider changes the vector space: re-ingest documents afterwards.

# --- LLM (any OpenAI-compatible endpoint) ---
# Local default: Ollama inside compose. On a Mac, Docker has no GPU access, so a 7B model is
# CPU-only (~30-60s/answer). For faster demos set LLM_MODEL=qwen2.5:3b.
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=ollama   # Ollama ignores this; a hosted provider needs a real key

# Hosted example (swap in, no code changes):
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-...

# --- Retrieval ---
RETRIEVAL_MODE=hybrid          # hybrid | vector | keyword
RETRIEVAL_TOP_K=5              # chunks passed to the LLM
RETRIEVAL_HIT_THRESHOLD=0.6    # "hit" for the retrieval hit-rate metric (see eval report calibration)

# --- Observability ---
# METRICS_TOKEN=change-me      # if set, /metrics requires "Authorization: Bearer <token>"
